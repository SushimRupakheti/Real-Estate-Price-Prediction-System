        {"indicator": "nearest_major_road_type", "label": "Major road class", "type": "categorical", "weight": 0.15, "scores": {
          "motorway": {"score": 100, "rule": "Nearest major road is motorway"},
          "trunk": {"score": 95, "rule": "Nearest major road is trunk"},
          "primary": {"score": 90, "rule": "Nearest major road is primary"},
          "secondary": {"score": 75, "rule": "Nearest major road is secondary"}
        }}
      ]
    },
    "recreation": {
      "label": "Recreation",
      "description": "Availability of mapped parks within 2 km.",
      "components": [
        {"indicator": "parks", "label": "Parks within 2 km", "type": "higher_is_better", "weight": 1.0, "unit": "places", "bands": [
          {"min": 8, "score": 100, "rule": "At least 8 parks within 2 km"},
          {"min": 4, "score": 80, "rule": "At least 4 parks within 2 km"},
