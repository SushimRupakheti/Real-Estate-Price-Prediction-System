          {"min": 4, "score": 80, "rule": "At least 4 bus stops within 1 km"},
          {"min": 2, "score": 55, "rule": "At least 2 bus stops within 1 km"},
          {"min": 1, "score": 30, "rule": "One bus stop within 1 km"},
          {"min": 0, "score": 0, "rule": "No mapped bus stops within 1 km"}
        ]},
        {"indicator": "nearest_major_road_distance_m", "label": "Nearest major road", "type": "lower_is_better", "weight": 0.30, "unit": "m", "bands": [
          {"max": 250, "score": 100, "rule": "Major road within 250 m"},
          {"max": 500, "score": 85, "rule": "Major road within 500 m"},
          {"max": 1000, "score": 60, "rule": "Major road within 1 km"},
          {"max": 2000, "score": 35, "rule": "Major road within 2 km"},
          {"max": null, "score": 10, "rule": "Major road farther than 2 km"}
