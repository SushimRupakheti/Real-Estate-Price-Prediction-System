        {"indicator": "colleges", "label": "Colleges within 1 km", "type": "higher_is_better", "weight": 0.30, "unit": "places", "bands": [
          {"min": 4, "score": 100, "rule": "At least 4 colleges within 1 km"},
          {"min": 2, "score": 75, "rule": "At least 2 colleges within 1 km"},
          {"min": 1, "score": 45, "rule": "One college within 1 km"},
          {"min": 0, "score": 0, "rule": "No mapped colleges within 1 km"}
