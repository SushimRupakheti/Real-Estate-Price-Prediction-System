          {"min": 4, "score": 100, "rule": "At least 4 supermarkets within 1 km"},
          {"min": 2, "score": 75, "rule": "At least 2 supermarkets within 1 km"},
          {"min": 1, "score": 45, "rule": "One supermarket within 1 km"},
          {"min": 0, "score": 0, "rule": "No mapped supermarkets within 1 km"}
        ]},
        {"indicator": "banks", "label": "Bank-tagged places within 1 km", "type": "higher_is_better", "weight": 0.30, "unit": "places", "bands": [
          {"min": 8, "score": 100, "rule": "At least 8 bank-tagged places within 1 km"},
          {"min": 4, "score": 75, "rule": "At least 4 bank-tagged places within 1 km"},
          {"min": 1, "score": 40, "rule": "At least one bank-tagged place within 1 km"},
          {"min": 0, "score": 0, "rule": "No mapped bank-tagged places within 1 km"}
        ]}
      ]
    },
    "public_transport": {
      "label": "Public Transport",
      "description": "Mapped bus-stop availability and access to the major-road network.",
