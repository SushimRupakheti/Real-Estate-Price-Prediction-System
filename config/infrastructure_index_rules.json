{
  "version": "1.0.0",
  "index_name": "Infrastructure Health Index",
  "missing_indicator_score": 0,
  "classifications": [
    {"min_score": 85, "label": "Excellent"},
    {"min_score": 70, "label": "Very Good"},
    {"min_score": 55, "label": "Good"},
    {"min_score": 35, "label": "Moderate"},
    {"min_score": 0, "label": "Limited"}
  ],
  "category_weights": {
    "accessibility": 0.22,
    "education": 0.18,
    "healthcare": 0.18,
    "commerce": 0.15,
    "public_transport": 0.17,
    "recreation": 0.10
  },
  "categories": {
    "accessibility": {
      "label": "Accessibility",
      "description": "Proximity and type of mapped road access.",
      "components": [
        {"indicator": "nearest_road_distance_m", "label": "Nearest road", "type": "lower_is_better", "weight": 0.35, "unit": "m", "bands": [
          {"max": 25, "score": 100, "rule": "Nearest mapped road within 25 m"},
          {"max": 75, "score": 85, "rule": "Nearest mapped road within 75 m"},
          {"max": 200, "score": 65, "rule": "Nearest mapped road within 200 m"},
          {"max": 500, "score": 40, "rule": "Nearest mapped road within 500 m"},
          {"max": null, "score": 15, "rule": "Nearest mapped road farther than 500 m"}
        ]},
        {"indicator": "nearest_major_road_distance_m", "label": "Nearest major road", "type": "lower_is_better", "weight": 0.40, "unit": "m", "bands": [
          {"max": 250, "score": 100, "rule": "Major road within 250 m"},
          {"max": 500, "score": 90, "rule": "Major road within 500 m"},
          {"max": 1000, "score": 70, "rule": "Major road within 1 km"},
          {"max": 2000, "score": 45, "rule": "Major road within 2 km"},
          {"max": null, "score": 20, "rule": "Major road farther than 2 km"}
        ]},
        {"indicator": "nearest_major_road_type", "label": "Major road class", "type": "categorical", "weight": 0.25, "scores": {
          "motorway": {"score": 100, "rule": "Nearest major road is motorway"},
          "trunk": {"score": 95, "rule": "Nearest major road is trunk"},
          "primary": {"score": 90, "rule": "Nearest major road is primary"},
          "secondary": {"score": 75, "rule": "Nearest major road is secondary"}
        }}
      ]
    },
    "education": {
      "label": "Education",
      "description": "Availability of mapped educational facilities within their configured radii.",
      "components": [
        {"indicator": "schools", "label": "Schools within 1 km", "type": "higher_is_better", "weight": 0.55, "unit": "places", "bands": [
          {"min": 10, "score": 100, "rule": "At least 10 schools within 1 km"},
          {"min": 5, "score": 80, "rule": "At least 5 schools within 1 km"},
          {"min": 2, "score": 55, "rule": "At least 2 schools within 1 km"},
          {"min": 1, "score": 30, "rule": "One school within 1 km"},
          {"min": 0, "score": 0, "rule": "No mapped schools within 1 km"}
