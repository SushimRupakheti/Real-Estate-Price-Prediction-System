          {"min": 3, "score": 100, "rule": "At least 3 kindergartens within 1 km"},
          {"min": 2, "score": 75, "rule": "At least 2 kindergartens within 1 km"},
          {"min": 1, "score": 45, "rule": "One kindergarten within 1 km"},
          {"min": 0, "score": 0, "rule": "No mapped kindergartens within 1 km"}
        ]}
      ]
    },
    "healthcare": {
