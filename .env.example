NRB_MACRO_ARCHIVE_URL=https://www.nrb.org.np/
NRB_ALLOWED_DOMAINS=nrb.org.np,www.nrb.org.np
NRB_REQUEST_TIMEOUT_SECONDS=20
NRB_REQUEST_RETRY_COUNT=3
NRB_MAX_DOWNLOAD_SIZE_MB=25
MACRO_STALE_AFTER_DAYS=60
MACRO_BASELINE_YEARS=5
MACRO_CALIBRATION_VERSION=mai_equal_v1
MACRO_FALLBACK_MAX_ADJUSTMENT_PERCENT=3
TEMP_DOWNLOAD_DIRECTORY=tmp/nrb
